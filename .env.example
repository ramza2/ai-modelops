# ModelOps environment configuration example.
# Prefer: ./scripts/deploy.sh  (creates .env interactively if missing)
# Manual: copy this file to `.env` and adjust. Do NOT commit real secrets.

# --- Runtime ---
MODELOPS_ENVIRONMENT=local
MODELOPS_DEBUG=false
BACKEND_PORT=8000
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# --- Linux server / Traefik (deploy/compose/docker-compose.server.yml) ---
# Used only by ./scripts/deploy-server.sh --env-file <server.env>.
# Replace placeholders on the target host; do NOT commit real hostnames/tokens.
# deploy-server.sh up rejects MODELOPS_ENVIRONMENT=local and POSTGRES_PASSWORD=modelops.
# MODELOPS_ENVIRONMENT=production
# POSTGRES_PASSWORD=replace-with-unique-server-password
# MODELOPS_ADMIN_BIND_IP=192.0.2.10
# FRONTEND_PORT=18081
# MODELOPS_GATEWAY_HOST=modelops-gateway.example.invalid
# MODELOPS_NODE_AGENT_TOKEN=replace-with-shared-node-agent-secret
# TRAEFIK_PUBLIC_NETWORK=traefik-public
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=replace-with-host-resolver-name
# Host Node Agent EnvironmentFile uses NODE_AGENT_TOKEN with the same secret
# (see deploy/systemd/node-agent.env.example).

# --- PostgreSQL (used by deploy/compose/docker-compose.yml) ---
POSTGRES_DB=modelops
POSTGRES_USER=modelops
POSTGRES_PASSWORD=modelops
POSTGRES_PORT=5432

# --- Management API (host-side tools: pytest / alembic) ---
# SQLAlchemy async URL (driver: asyncpg). Alembic derives a psycopg2 URL from this.
# Inside Compose, the backend service overrides the host to "postgres".
# Prefer letting ./scripts/deploy.sh generate this from POSTGRES_* values.
MODELOPS_DATABASE_URL=postgresql+asyncpg://modelops:modelops@localhost:5432/modelops

# --- Node Agent (Management API client settings) ---
# Backend calls the Node Agent; it never opens Docker/NVML itself.
# Placeholder URL/token only — do not commit real internal addresses or secrets.
MODELOPS_NODE_AGENT_BASE_URL=http://host.docker.internal:8100
MODELOPS_NODE_AGENT_TOKEN=
MODELOPS_NODE_AGENT_TIMEOUT_SECONDS=5
MODELOPS_DEFAULT_GPU_SAFETY_MARGIN_MB=1024

# --- Node Agent process (host service; recommended over Compose for GPU/Docker access) ---
# Bind 0.0.0.0 on Windows so Backend containers can reach the agent via host.docker.internal.
# Host-side curls can still use http://127.0.0.1:8100.
NODE_AGENT_HOST=0.0.0.0
NODE_AGENT_PORT=8100
# Shared Bearer secret. Empty disables auth for local convenience only.
NODE_AGENT_TOKEN=
NODE_AGENT_DISK_PATH=/
# Docker Engine call budget (inspect/create/start/stop). Image pull uses a separate budget.
NODE_AGENT_DOCKER_TIMEOUT_SECONDS=2
NODE_AGENT_DOCKER_IMAGE_PULL_TIMEOUT_SECONDS=300

# --- Orchestrator Worker (Milestone 3B-2 / 3B-3) ---
# Polls operation_job via PostgreSQL FOR UPDATE SKIP LOCKED; calls Node Agent.
MODELOPS_WORKER_ID=worker-local-1
MODELOPS_WORKER_POLL_SECONDS=1
MODELOPS_WORKER_MAX_ATTEMPTS=3
MODELOPS_WORKER_STALE_SECONDS=60
MODELOPS_WORKER_LOCK_REQUEUE_SECONDS=2
# Prepare / health / probe / VRAM wait budgets (Worker Settings defaults).
# Prepare HTTP timeout = max(lifecycle default, image_pull + prepare_http_safety).
MODELOPS_NODE_AGENT_IMAGE_PULL_TIMEOUT_SECONDS=300
MODELOPS_PREPARE_HTTP_SAFETY_SECONDS=30
MODELOPS_HEALTH_TIMEOUT_SECONDS=120
MODELOPS_HEALTH_POLL_INTERVAL_SECONDS=1
MODELOPS_PROBE_TIMEOUT_SECONDS=60
MODELOPS_VRAM_RELEASE_TIMEOUT_SECONDS=60
MODELOPS_VRAM_RELEASE_POLL_INTERVAL_MS=200
# M5-B Cold Switch control-plane (Worker → Gateway; not inference path).
# Host-side Worker / local tools may use 127.0.0.1. Inside Compose the
# worker service overrides this to http://gateway:8080 (never container localhost).
MODELOPS_GATEWAY_BASE_URL=http://127.0.0.1:8080
MODELOPS_GATEWAY_TIMEOUT_SECONDS=10
MODELOPS_GATEWAY_APPLY_TIMEOUT_SECONDS=30
MODELOPS_DRAIN_TIMEOUT_SECONDS=60
MODELOPS_GATEWAY_POLL_INTERVAL_SECONDS=0.5
MODELOPS_DEFAULT_GPU_SAFETY_MARGIN_MB=1024

# --- AI Gateway (Milestone 4-A / 4-B) ---
# OpenAI-compatible entrypoint; routing snapshot + LISTEN/NOTIFY + polling fallback.
MODELOPS_UPSTREAM_TIMEOUT_SECONDS=60
MODELOPS_ROUTING_POLL_SECONDS=2
MODELOPS_ROUTING_LISTEN_RECONNECT_SECONDS=2
