# ModelOps Node Agent host EnvironmentFile example.
# Copy outside Git (for example /etc/modelops/node-agent.env), set secrets,
# restrict permissions (installer uses 0600 root:root), and pass --env-file.
# Do NOT commit real tokens.

# Bind on all interfaces so Backend/Worker containers can reach the host via
# host.docker.internal:host-gateway. Port 8100 must NOT be publicly exposed;
# restrict with host firewall / network policy. Installer does not change firewall.
# Never put Node Agent behind Traefik.
NODE_AGENT_HOST=0.0.0.0
NODE_AGENT_PORT=8100

# Required on server. Must match Control Plane MODELOPS_NODE_AGENT_TOKEN
# (separate env namespaces — do not merge in application code).
NODE_AGENT_TOKEN=

NODE_AGENT_DISK_PATH=/
NODE_AGENT_DOCKER_TIMEOUT_SECONDS=2
NODE_AGENT_DOCKER_IMAGE_PULL_TIMEOUT_SECONDS=300
